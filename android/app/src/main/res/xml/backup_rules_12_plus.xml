<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="models/"/>
        <!-- Neural TTS model files (Supertonic, ~265 MB) live under files/tts/ -->
        <exclude domain="file" path="tts/"/>
        <!-- only created in debuggable builds, but can be large and exceed
         25mb cloud backup limit which makes dev testing difficult -->
        <exclude domain="file" path="BridgeReactNativeDevBundle.js"/>
        <exclude domain="file" path="ReactNativeDevBundle.js"/>
        <exclude domain="root" path="code_cache/"/>
        <!-- Audit SEC-01: the conversation database (drsai.db*) plus the
             database domain (RKStorage/AsyncStorage — including the drshub
             session — and the Room download metadata) and shared prefs hold
             the user's private history and configuration. Keep them out of
             cloud backups entirely instead of trusting transport encryption;
             the app offers explicit chat export (JSON/PDF) instead. -->
        <exclude domain="root" path="drsai.db"/>
        <exclude domain="root" path="drsai.db-wal"/>
        <exclude domain="root" path="drsai.db-shm"/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>

    <device-transfer>
        <exclude domain="file" path="models/"/>
        <exclude domain="file" path="tts/"/>
        <exclude domain="file" path="BridgeReactNativeDevBundle.js"/>
        <exclude domain="file" path="ReactNativeDevBundle.js"/>
        <exclude domain="root" path="code_cache/"/>
        <!-- Audit SEC-01: same privacy rationale as cloud-backup above. -->
        <exclude domain="root" path="drsai.db"/>
        <exclude domain="root" path="drsai.db-wal"/>
        <exclude domain="root" path="drsai.db-shm"/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>