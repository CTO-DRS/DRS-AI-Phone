<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext (HTTP) is permitted at the platform level because DrsAI
         connects to local LLM servers (LM Studio, Ollama, llama.cpp) on the
         user's LAN, where URLs are user-entered and arbitrary LAN IPs cannot
         be expressed as NSC domain rules. The compensating control is the
         app-layer guard (src/utils/network.ts -> isCleartextUrlAllowed):
         http:// URLs for public hosts are rejected before they can be saved,
         so real traffic over cleartext stays LAN-only (audit F-02/R-02). -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
