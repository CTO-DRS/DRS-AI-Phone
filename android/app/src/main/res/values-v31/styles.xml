<?xml version="1.0" encoding="utf-8"?>
<!--
  DRS AI system splash (Android 12+ / API 31+).

  Android 12 replaces the windowBackground splash with the system splash
  screen, so we brand it here: brand-indigo background with the launcher
  adaptive icon (the DRS robot head) as the splash icon. This mirrors the
  classic bg_splash hand-off and the in-app SplashScreen.
-->
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/drsai_violet_deep</item>
        <item name="android:navigationBarColor">@color/drsai_dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

        <!-- System splash screen (Android 12+). -->
        <item name="android:windowSplashScreenBackground">@color/drsai_indigo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
