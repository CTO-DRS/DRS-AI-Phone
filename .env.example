APP_RELEASE_STORE_PASSWORD=
APP_RELEASE_KEY_PASSWORD=

FIREBASE_FUNCTIONS_URL=

# Debug tokens (only for local development)
APPCHECK_DEBUG_TOKEN_ANDROID=
APPCHECK_DEBUG_TOKEN_IOS=

# Drshub/Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
DRSHUB_API_BASE_URL=https://hub.drsai.app

# App Configuration
APP_URL=drsai://app

# NOTE (CODE-04): the legacy ENABLE_* feature flags were removed — nothing in
# src/ ever read them. Real gates:
#  - drshub integration is on iff DRSHUB_API_BASE_URL is set (missing value
#    => DrshubApiService rejects every call with "not configured");
#  - authentication is driven by the Supabase session, not a flag;
#  - offline is the default behavior of the local llama.rn stack.

# Google Sign-In Configuration
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
