    "@wdio/junit-reporter": "^9.4.4",
    "appium": "^2.15.1",
    "appium-uiautomator2-driver": "^3.8.1",
    "appium-xcuitest-driver": "^7.32.5",
    "@aws-sdk/client-device-farm": "^3.693.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@wdio/globals": "^9.4.5",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "resolutions": {
    "qs": "6.16.1",
    "fast-uri": "3.1.9",
