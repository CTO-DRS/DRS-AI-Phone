{
  "name": "drsai-e2e",
  "version": "1.0.0",
  "description": "E2E tests for DrsAI using Appium + WebDriverIO",
  "scripts": {
    "e2e": "npx ts-node scripts/run-e2e.ts",
    "e2e:ios": "npx ts-node scripts/run-e2e.ts --platform ios",
    "e2e:android": "npx ts-node scripts/run-e2e.ts --platform android",
    "e2e:models:ios": "npx ts-node scripts/run-e2e.ts --platform ios --each-model",
    "e2e:models:android": "npx ts-node scripts/run-e2e.ts --platform android --each-model",
    "e2e:aws": "npx ts-node scripts/run-aws-device-farm.ts",
    "build:bench-config": "npx ts-node scripts/build-bench-config.ts",
    "bench:ios": "npx ts-node scripts/run-bench-ios.ts",
    "analyze:tts-audio": "npx tsx scripts/analyze-tts-audio.ts",
    "test:analyze-tts-audio": "npx tsx scripts/__tests__/analyze-tts-audio.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@wdio/appium-service": "^9.4.5",
    "@wdio/cli": "^9.4.5",
    "@wdio/local-runner": "^9.4.5",
